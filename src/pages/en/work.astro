---
import Layout from '../../components/Layout.astro';
import Experience from '../../components/Experience.astro';
import Education from '../../components/Education.astro';
import Skills from '../../components/Skills.astro';
import { site, withBase } from '../../data/site';
import { experience } from '../../data/resume';
import { useT } from '../../utils/t';
import { DEFAULT_LOCALE } from '../../i18n';

const locale = (Astro.currentLocale as 'zh-CN' | 'en' | undefined) ?? DEFAULT_LOCALE;
const t = useT(locale);

const current = experience[0];
const links = Object.values(site.socials).filter((s): s is NonNullable<typeof s> => s !== null && (s.url.startsWith('http') || s.url.startsWith('mailto')));

const description = current
  ? `${site.author.name} — ${current.role} at ${current.company}.`
  : `${site.author.name}'s work experience.`;
---

<Layout
  title={t('work.eyebrow')}
  description={description}
  image="/images/og.jpg"
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t('work.eyebrow')}</p>
      <h1>{site.author.name}</h1>
      {current && (
        <p class="muted" style="margin: 0 0 0.25rem;">
          {current.role} · {current.company}
        </p>
      )}
      <p class="muted" style="margin: 0 0 1.5rem;">
        {site.author.location}
        {links.map((s) => (
          <>
            {' · '}
            <a href={withBase(s.url)} target={s.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{s.label}</a>
          </>
        ))}
      </p>
    </div>
  </section>

  <Experience />
  <Education />
  <Skills />
</Layout>
