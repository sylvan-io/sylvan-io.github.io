---
import Hero from '../../components/Hero.astro';
import Layout from '../../components/Layout.astro';
import { getExperience, skillGroups } from '../../data/resume';
import { site, withBase } from '../../data/site';
import { DEFAULT_LOCALE, type Locale } from '../../i18n';

const locale: Locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const currentJob = getExperience(locale)[0];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author.name,
  url: site.url,
  image: `${site.url}${withBase('/images/og.jpg')}`,
  jobTitle: currentJob?.role,
  worksFor: { '@type': 'Organization', name: currentJob?.company },
  email: `mailto:${site.author.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.author.location,
  },
  sameAs: [
    site.socials.github?.url,
    site.socials.juejin?.url,
  ].filter((url): url is string => Boolean(url)),
  knowsAbout: skillGroups.flatMap((g) => g.skills).slice(0, 8),
};
---

<Layout title={undefined} jsonLd={personJsonLd}>
  <Hero />
</Layout>
