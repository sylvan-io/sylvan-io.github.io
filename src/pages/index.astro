---
/**
 * Root splash page.
 *
 * The site root (`/`) is intentionally not a content page - it bounces to
 * `/blog` (or `/en/blog` for English visitors). This page exists to give the
 * visitor something on-brand to look at during the redirect instead of an
 * empty white flash, and to provide a fallback path if JavaScript is off.
 *
 * Locale strategy
 *   - Static build: there is no per-request Accept-Language at build time,
 *     so the server-rendered HTML always defaults to zh-CN and the meta
 *     refresh points at `/blog`. This is the safe no-JS fallback.
 *   - Client-side: an inline script reads `navigator.language`, and when
 *     it starts with `en` it rewrites the splash text, the meta refresh
 *     target, and the manual-link href to point at `/en/blog`. The 700 ms
 *     redirect happens from the same script (0 ms when the user prefers
 *     reduced motion).
 *
 * Design references
 *   - Brand mark `> sylvan_` lifted from `components/Header.astro`.
 *   - Starfield background reused from the Hero via the existing `.stars`
 *     class - no CSS duplication.
 *   - Color tokens, font tokens, and radii come from `styles/global.css`.
 */

import '../styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

const META_FALLBACK_MS = 2000;
const DEFAULT_TARGET = '/blog';

const title = '\u6b63\u5728\u8df3\u8f6c\u2026';
const htmlLang = 'zh-CN';
const hintText = '\u6b63\u5728\u524d\u5f80\u535a\u5ba2';
const fallbackBefore = '\u5982\u679c\u9875\u9762\u6ca1\u6709\u81ea\u52a8\u8df3\u8f6c\uff0c';
const fallbackLink = '\u70b9\u51fb\u8fd9\u91cc';
const description = '\u6b63\u5728\u8df3\u8f6c\u81f3\u535a\u5ba2\u2026';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#fafafa" />
    <meta http-equiv="refresh" content={`${META_FALLBACK_MS / 1000};url=${DEFAULT_TARGET}`} data-meta-refresh />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Apply the saved theme before paint to avoid a flash. -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>

    <style>
      html, body { height: 100%; }
      body { margin: 0; }

      .splash {
        position: relative;
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: var(--bg);
      }

      .splash .stars {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .splash-inner {
        position: relative;
        z-index: 1;
        text-align: center;
        max-width: 560px;
        padding: 4rem 1.25rem;
      }

      .splash .eyebrow {
        margin: 0 0 1.25rem;
      }

      .brand-mark {
        font-family: var(--font-mono);
        font-size: clamp(2.4rem, 7vw, 4rem);
        font-weight: 700;
        color: var(--text-strong);
        letter-spacing: -0.02em;
        margin: 0 0 1.25rem;
        line-height: 1.1;
      }

      .brand-mark .prompt {
        color: var(--muted);
        font-weight: 500;
        margin-right: 0.4rem;
      }

      .brand-mark .cursor {
        color: var(--accent);
        margin-left: 0.05em;
        animation: splash-blink 1.1s steps(2, start) infinite;
      }

      .splash-hint {
        font-family: var(--font-mono);
        font-size: 0.95rem;
        color: var(--muted);
        margin: 0 0 1.5rem;
      }

      .splash-hint .arrow {
        color: var(--accent);
        margin-right: 0.4rem;
      }

      .splash-hint .path {
        opacity: 0.7;
      }

      .splash-loader {
        display: inline-flex;
        align-items: baseline;
        gap: 0.45rem;
        font-family: var(--font-mono);
        font-size: 1.05rem;
        color: var(--muted);
        margin-bottom: 2rem;
      }

      .splash-loader .dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        animation: splash-bounce 1s ease-in-out infinite;
      }

      .splash-loader .dot:nth-child(2) { animation-delay: 0.15s; }
      .splash-loader .dot:nth-child(3) { animation-delay: 0.3s; }

      .splash-loader .caret {
        color: var(--accent);
        margin-left: 0.25rem;
        animation: splash-blink 1.1s steps(2, start) infinite;
      }

      .splash-fallback {
        font-size: 0.9rem;
        color: var(--muted);
        margin: 0;
      }

      .splash-fallback a {
        color: var(--accent);
        font-weight: 600;
      }

      .splash-fallback a:hover {
        color: var(--accent-strong);
      }

      @keyframes splash-blink {
        to { opacity: 0; }
      }

      @keyframes splash-bounce {
        0%, 80%, 100% { transform: translateY(0); opacity: 0.45; }
        40% { transform: translateY(-5px); opacity: 1; }
      }

      @media (prefers-reduced-motion: reduce) {
        .brand-mark .cursor,
        .splash-loader .caret,
        .splash-loader .dot {
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <main class="splash">
      <div class="stars" aria-hidden="true"></div>
      <div class="container splash-inner">
        <p class="eyebrow" aria-hidden="true">WANDERER · HOME</p>

        <h1 class="brand-mark">
          <span class="prompt" aria-hidden="true">&gt;</span>Sylvan<span class="cursor" aria-hidden="true">_</span>
        </h1>

        <p class="splash-hint">
          <span class="arrow" aria-hidden="true">→</span><span data-splash-hint>{hintText}</span><span class="path" data-splash-path> · {DEFAULT_TARGET}</span>
        </p>

        <div class="splash-loader" aria-hidden="true">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="caret">▍</span>
        </div>

        <p class="splash-fallback">
          <span data-splash-fallback-before>{fallbackBefore}</span><a href={DEFAULT_TARGET} data-splash-link>{fallbackLink}</a> →
        </p>
      </div>
    </main>

    <script is:inline>
      // Mirrors the constants above so this inline script (treated as JS,
      // not TS) can read them without `define:vars` typecheck friction.
      var defaultTarget = '/blog';
      var enTarget = '/en/blog';
      var delayMs = 700;
      var enMessages = {
        htmlLang: 'en',
        title: 'Redirecting…',
        description: 'Redirecting to the blog…',
        hint: 'taking you to the blog',
        fallbackBefore: "If the page doesn't redirect, ",
        fallbackLink: 'click here',
      };

      (function () {
        var lang = (navigator.language || navigator.userLanguage || '').toLowerCase();
        var isEn = lang.indexOf('en') === 0;
        var target = isEn ? enTarget : defaultTarget;

        if (isEn) {
          var msg = enMessages;
          document.documentElement.lang = msg.htmlLang;
          document.title = msg.title;
          var metaDesc = document.querySelector('meta[name="description"]');
          if (metaDesc) metaDesc.setAttribute('content', msg.description);

          var metaRefresh = document.querySelector('[data-meta-refresh]');
          if (metaRefresh) metaRefresh.setAttribute('content', '2;url=' + target);

          var hintEl = document.querySelector('[data-splash-hint]');
          if (hintEl) hintEl.textContent = msg.hint;

          var pathEl = document.querySelector('[data-splash-path]');
          if (pathEl) pathEl.textContent = ' · ' + target;

          var fbBefore = document.querySelector('[data-splash-fallback-before]');
          if (fbBefore) fbBefore.textContent = msg.fallbackBefore;

          var fbLink = document.querySelector('[data-splash-link]');
          if (fbLink) {
            fbLink.textContent = msg.fallbackLink;
            fbLink.setAttribute('href', target);
          }
        }

        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var wait = reduce ? 0 : delayMs;
        setTimeout(function () {
          window.location.replace(target);
        }, wait);
      })();
    </script>
  </body>
</html>
