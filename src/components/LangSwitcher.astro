---
/**
 * Renders a tiny language toggle in the header.
 *
 * Behavior:
 *   - On desktop: a single `<a>` element styled like a nav link.
 *     The label is the name of the OTHER locale ("中文" when on /en/, etc.).
 *   - On mobile: same single element, label still visible.
 *   - The link's href is computed by swapping the locale prefix of the
 *     current pathname. If a translation is unavailable the link still
 *     works — the destination page will show the fallback content.
 */
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_LABELS,
  prefixPathname,
  stripLocalePrefix,
  type Locale,
} from '../i18n';

interface Props {
  locale?: Locale;
  /** Optional class for styling. */
  class?: string;
}

const { locale = DEFAULT_LOCALE, class: className } = Astro.props;

const otherLocale = LOCALES.find((l) => l !== locale) ?? DEFAULT_LOCALE;
// Strip the CURRENT locale prefix (not the target's), otherwise pages under
// `/en/...` would resolve to themselves when the target is the default locale.
const stripped = stripLocalePrefix(Astro.url.pathname, locale);
const targetPath = prefixPathname(stripped, otherLocale);
const ariaLabel = `Switch to ${LOCALE_LABELS[otherLocale]}`;
---

<a
  class:list={['lang-switcher', className]}
  href={targetPath}
  hreflang={otherLocale}
  aria-label={ariaLabel}
  title={ariaLabel}
>
  <span aria-hidden="true">🌐</span>
  <span class="lang-switcher__label">{LOCALE_LABELS[otherLocale]}</span>
</a>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm, 6px);
  }
  .lang-switcher:hover {
    background: var(--surface);
  }
  @media (max-width: 540px) {
    .lang-switcher__label {
      display: none;
    }
  }
</style>
