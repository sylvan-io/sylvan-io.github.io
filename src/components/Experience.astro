---
import { getExperience, type ResolvedExperience } from '../data/resume';
import { DEFAULT_LOCALE, type Locale } from '../i18n';
import { useT } from '../utils/t';

interface Props {
  locale?: Locale;
}

const { locale: localeProp } = Astro.props;
const locale: Locale = (localeProp ?? (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE) as Locale;
const t = useT(locale);

const items = getExperience(locale);

const formatDate = (e: ResolvedExperience) =>
  e.current ? `${e.start} – ${t('work.datePresent')}` : `${e.start} – ${e.end}`;
---

<section class="section section-alt" id="experience">
  <div class="container">
    <p class="eyebrow">{t('work.sectionExperienceEyebrow')}</p>
    <h2 class="section-heading">{t('work.sectionExperienceHeading')}</h2>

    <ul class="timeline">
      {
        items.map((e) => (
          <li class:list={['timeline-item', { current: e.current }]}>
            <div class="timeline-head">
              <span class="timeline-role">
                {e.role}
                <span class="timeline-company"> · {e.company}</span>
              </span>
              <span class="timeline-date">{formatDate(e)}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
