---
import { skillGroups } from '../data/resume';
import { useT } from '../utils/t';
import { DEFAULT_LOCALE, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale: localeProp } = Astro.props;
const locale: Locale = (localeProp ?? (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE) as Locale;
const t = useT(locale);
---

<section class="section section-alt" id="skills">
  <div class="container">
    <p class="eyebrow">{t('work.sectionSkillsEyebrow')}</p>
    <h2 class="section-heading">{t('work.sectionSkillsHeading')}</h2>
    {
      skillGroups.map((group) => (
        <div class="skill-group">
          <h3>{group.title}</h3>
          <div class="chip-row">
            {group.skills.map((s) => <span class="chip">{s}</span>)}
          </div>
        </div>
      ))
    }
  </div>
</section>
