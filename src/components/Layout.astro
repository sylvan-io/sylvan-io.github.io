---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { site, withBase, siteDescription } from '../data/site';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_BCP47,
  OG_LOCALES,
  prefixPathname,
  stripLocalePrefix,
  type Locale,
} from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object;
  /**
   * Override the resolved locale for this page. Defaults to
   * `Astro.currentLocale`. Most pages can leave this empty.
   */
  locale?: Locale;
  /**
   * Override the `<html lang>` attribute. Defaults to the page locale.
   * Use this when a page renders content in a different language than the
   * URL suggests (e.g. an English URL falling back to Chinese content).
   */
  htmlLang?: string;
}

const {
  title,
  description,
  image = '/images/og.jpg',
  type = 'website',
  canonical: canonicalProp,
  noindex = false,
  jsonLd,
  locale: localeProp,
  htmlLang: htmlLangProp,
} = Astro.props;

// Resolve page locale. Astro.currentLocale is typed as string | undefined.
const pageLocale: Locale = (localeProp ??
  (Astro.currentLocale as Locale | undefined) ??
  DEFAULT_LOCALE) as Locale;

const resolvedDescription = description ?? siteDescription(pageLocale);
const pageTitle = title ? `${title} · ${site.shortTitle}` : site.title;
const imageUrl = withBase(image);

// <html lang> — follows htmlLang if provided, otherwise the page locale.
const htmlLang = htmlLangProp ?? LOCALE_BCP47[pageLocale];

// canonical — explicit override wins, otherwise derive from Astro.url
const canonical = canonicalProp ?? `${site.url}${Astro.url.pathname}`;

// hreflang alternates — only emit for pages where translation is meaningful.
// We emit one entry per configured locale, plus x-default pointing at the
// default-locale URL.
const pathname = stripLocalePrefix(Astro.url.pathname, pageLocale);
const hreflangs = LOCALES.map((loc) => ({
  hreflang: LOCALE_BCP47[loc],
  href: `${site.url}${prefixPathname(pathname, loc)}`,
}));
hreflangs.push({
  hreflang: 'x-default',
  href: `${site.url}${prefixPathname(pathname, DEFAULT_LOCALE)}`,
});

const ogLocale = OG_LOCALES[pageLocale];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <meta name="author" content={site.author.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={withBase(pageLocale === DEFAULT_LOCALE ? '/rss.xml' : '/en/rss.xml')} />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex" />}

    {hreflangs.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Theme: set before paint to avoid flash -->
    <script is:inline>
      const t = localStorage.getItem('theme');
      const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>

    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <Header locale={pageLocale} />
    <main>
      <slot />
    </main>
    <Footer locale={pageLocale} />
  </body>
</html>
