{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "01 - Astro: Dev (热更新开发)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local\\s+(https?://localhost:\\d+/?)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "02 - Astro: Build (编译)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "03 - Astro: Preview (预览构建产物)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "astro:build",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local\\s+(https?://localhost:\\d+/?)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "04 - Astro: Check (类型检查)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "check"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
